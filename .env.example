# EchoVault AI Configuration
ECHOVAULT_DATA_DIR=data
ECHOVAULT_DB_PATH=data/echovault.db

# Ollama & Gemma Configuration
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma:2b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_MAX_RETRIES=2

# Audio Settings
MAX_AUDIO_SIZE_MB=25
WHISPER_MODEL_SIZE=tiny

# Application Settings
DEBUG=false
APP_TITLE=EchoVault AI
TAGLINE=Some voices fade. Their stories don't have to.
